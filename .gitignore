# =============================================================
#  .gitignore raíz — app-finanzas (
# =============================================================

# -------------------------------------------------------------
# 1. variables de entorno
# -------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa*
id_ed25519*
auth.json
secrets/
credentials*.json
service-account*.json

# -------------------------------------------------------------
# 2. Backend — Laravel / PHP
#    El contenido de storage/ y bootstrap/cache/ lo controlan los
#    .gitignore internos de Laravel (mantienen las carpetas vacías en el repo)
# -------------------------------------------------------------
backend/vendor/
backend/storage/*.key
backend/storage/pail/
backend/public/storage
backend/public/hot
backend/public/build/
.phpunit.cache/
.phpunit.result.cache
.php-cs-fixer.cache
phpstan.neon.local

# -------------------------------------------------------------
# 3. Frontend — Next.js / Node
# -------------------------------------------------------------
node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/coverage/
frontend/next-env.d.ts
*.tsbuildinfo
.vercel/
.turbo/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -------------------------------------------------------------
# 4. Docker
#    Los datos de Postgres viven en un volumen con nombre (pgdata),
#    pero por si algún día se monta una carpeta local:
# -------------------------------------------------------------
docker-compose.override.yml
docker/data/
pgdata/

# -------------------------------------------------------------
# 5. Bases de datos y volcados
#    Un dump puede contener datos financieros reales
# -------------------------------------------------------------
*.sql
!backend/database/schema/*.sql
*.sql.gz
*.dump
*.backup
*.sqlite
*.sqlite3
*.db

# -------------------------------------------------------------
# 6. Logs, temporales y cachés genéricos
# -------------------------------------------------------------
*.log
/logs/
/tmp/
/temp/
*.tmp
*.swp
*.swo
*~
.cache/

# -------------------------------------------------------------
# 7. Editores e IDEs
# -------------------------------------------------------------
.idea/
.vscode/
*.code-workspace
.fleet/
*.sublime-project
*.sublime-workspace

# -------------------------------------------------------------
# 8. Sistema operativo
# -------------------------------------------------------------
# macOS
.DS_Store
._*
# Windows
Thumbs.db
desktop.ini
*:Zone.Identifier
# Linux
.directory
.Trash-*

# -------------------------------------------------------------
# 9. Herramientas locales (asistentes de IA, etc.)
# -------------------------------------------------------------
.claude/settings.local.json
